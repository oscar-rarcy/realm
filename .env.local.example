# Copy this file to .env.local for personal visual-mode preferences.
#
# Options:
#   ascii-only
#     Force the SDL and web builds to start as ASCII-only and hide the
#     tileset/emoji visual selector. Normal SDL/web builds also skip the
#     tileset loader and assets in this mode.
#
#   tileset-menu
#     Start SDL/web builds in the tileset visual mode and keep ASCII available
#     as a menu option.
#
# The committed .env defaults to ascii-only. .env.local is ignored by git.
REALM_VISUAL_MODE=tileset-menu
